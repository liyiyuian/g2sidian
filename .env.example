# Copy to .env next to docker-compose.yml (chmod 600). Never commit .env.

# A long random string; the backend refuses to start without it:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
G2SIDIAN_TOKEN=change-me

# Host path of the vault you want on the glasses (mounted read-only by default).
G2SIDIAN_VAULT_DIR=/path/to/your/Obsidian/vault

# What the backend calls the vault + where the container sees it. With the
# single default mount in docker-compose.yml the path is /vaults/vault.
G2SIDIAN_VAULTS=[{"name":"Personal","path":"/vaults/vault"}]

# Optional — enables voice capture (Whisper). Leave empty or unset to disable.
OPENAI_API_KEY=
